[Unit]
Description=BEATNET backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/beatnet-backend
ExecStart=/home/ubuntu/.bun/bin/bun --env-file=/home/ubuntu/.config/beatnet/backend.env server/index.ts
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
